+def _has_place_on_grid(verilog_d, primitives):
+    """설계 어디에도 PlaceOnGrid 가 없으면 격자 제약 생성은 공집합이다."""
+    for prim in (primitives or {}).values():
+        md = prim.get('metadata') or {}
+        for c in md.get('constraints') or []:
+            if (c.get('constraint') if isinstance(c, dict) else getattr(c, 'constraint', None)) == 'PlaceOnGrid':
+                return True
+    mods = verilog_d.get('modules') if isinstance(verilog_d, dict) else getattr(verilog_d, 'modules', [])
+    for m in mods or []:
+        cs = m.get('constraints') if isinstance(m, dict) else getattr(m, 'constraints', [])
+        for c in cs or []:
+            if (c.get('constraint') if isinstance(c, dict) else getattr(c, 'constraint', None)) == 'PlaceOnGrid':
+                return True
+    return False
+
+
 def update_grid_constraints(grid_constraints, DB, idx, verilog_d, primitives, scale_factor):
     assert verilog_d is not None
     assert primitives is not None
 
+    if not _has_place_on_grid(verilog_d, primitives):
+        # 설계에 PlaceOnGrid 가 없다 -> 결과는 반드시 공집합.
+        # 무거운 중간물(gen_placement_verilog/scale_placement_verilog)을 만들지 않는다.
+        return
+
     # for each layout, generate a placement_verilog_d, make sure the constraints are attached to the leaves, then generate the restrictions
     # convert the restrictions into the form needed for the subsequent placements
 
